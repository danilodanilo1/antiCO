{
  "name": "antico",
  "version": "0.2.0",
  "description": "Sistema de auditoria cívica OSINT — investigação de despesas parlamentares",
  "type": "module",
  "scripts": {
    "investigar": "tsx scripts/investigar.ts",
    "api": "tsx watch src/server/index.ts",
    "ui": "vite --config web/vite.config.ts",
    "dev": "concurrently -n api,ui -c blue,green \"npm run api\" \"npm run ui\"",
    "build": "tsc",
    "build:ui": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "npx playwright install chromium || true"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "playwright": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
